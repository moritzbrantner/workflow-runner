{
  "name": "@moritzbrantner/workflow-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "test": "bun test",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun test && bun run build"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
