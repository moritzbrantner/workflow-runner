            "mediaType": "audio/wav"
          }
        },
        {
          "id": "chunks",
          "type": {
            "kind": "typescript",
            "source": "Uint8Array"
          },
          "payload": {
            "mode": "streamed",
            "mediaType": "audio/wav"
          }
        }
      ]
    },
    {
      "id": "archive",
      "label": "Archive WAV",
      "kind": "audio.archive",
      "inputs": [
        {
          "id": "wav",
          "type": {
            "kind": "typescript",
            "source": "Uint8Array"
          },
          "payload": {
            "mode": "buffered",
            "mediaType": "audio/wav"
          }
        }
      ]
    },
    {
      "id": "live-preview",
      "label": "Live preview",
      "kind": "audio.preview",
      "inputs": [
        {
          "id": "chunks",
          "type": {
            "kind": "typescript",
            "source": "Uint8Array"
          },
          "payload": {
            "mode": "streamed",
            "mediaType": "audio/wav"
          }
        }
      ]
    },
    {
      "id": "transcribe",
